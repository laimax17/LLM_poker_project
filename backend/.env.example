# ── Cloud LLM providers (OpenAI-compatible) ──────────────────────────────────
# Fill in whichever provider key(s) you have — each provider needs just ONE key.
# Providers without a key simply show as offline in the UI.

# OpenRouter — one key, access to GPT / Claude / Gemini / DeepSeek / Qwen / Llama
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# DeepSeek (direct) — cheapest, great Chinese; deepseek-chat / deepseek-reasoner
# Get a key at https://platform.deepseek.com
DEEPSEEK_API_KEY=

# ── Ollama 本地推理（无需 key）────────────────────────────────────────────────
# Ollama 服务地址。宿主机直接运行时用 localhost；Docker 内访问宿主机用 host.docker.internal
OLLAMA_HOST=http://localhost:11434

# Ollama 默认模型，需与 `ollama pull <model>` 时一致
OLLAMA_MODEL=qwen2.5:7b

# ── 游戏引擎 ──────────────────────────────────────────────────────────────────
# 服务启动时使用的默认 AI 引擎
# 可选值：rule-based | gto | ollama | openrouter | deepseek
DEFAULT_AI_ENGINE=rule-based

# 启动时的默认云端模型（仅当 DEFAULT_AI_ENGINE 为某个云 provider 时生效）
# 例如 OpenRouter: openai/gpt-4o-mini   DeepSeek: deepseek-chat
LLM_MODEL=
